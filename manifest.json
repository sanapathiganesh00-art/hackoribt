{
  "manifest_version": 3,
  "name": "Sentrywall Enforcer",
  "version": "1.0.0",
  "description": "Demo enforcement layer for Sentrywall centralized application-context firewall.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sentrywall Enforcer"
  }
}